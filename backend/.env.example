# Google sign-in (docs/google-sign-in.md). Entirely inert until all four are
# set; STUDIO_GOOGLE_CLIENT_SECRET and STUDIO_SESSION_SECRET are secrets —
# put real values in the backend host's secret manager, never in a committed
# .env file.
STUDIO_GOOGLE_ENABLED=false
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
STUDIO_SESSION_SECRET=
